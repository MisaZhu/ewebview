# use ccache transparently when installed (brew install ccache)
CCACHE := $(shell command -v ccache 2>/dev/null)

#PREIX = aarch64-none-elf-

AR = $(PREIX)ar
AS = $(PREIX)as
CC = $(CCACHE) $(PREIX)gcc
CXX = $(CCACHE) $(PREIX)c++
LD_BIN = aarch64-none-elf-ld
# ensure the output directory exists before linking (parallel-safe)
LD = mkdir -p $(dir $@) && $(LD_BIN)
OBJDUMP =  $(PREIX)objdump


HOST_ARCH := $(shell uname -m)
HOST_ARCH_FLAGS =
ifeq ($(filter arm64 aarch64,$(HOST_ARCH)), $(HOST_ARCH))
HOST_ARCH_FLAGS = -march=armv8-a -mstrict-align -mno-outline-atomics
endif
HOST_POSIX_FLAGS =
ifneq ($(shell uname -s),Darwin)
HOST_POSIX_FLAGS = -D_DEFAULT_SOURCE -D_POSIX_C_SOURCE=200809L
endif

CFLAGS =  $(HOST_ARCH_FLAGS) $(HOST_POSIX_FLAGS) -Wno-incompatible-pointer-types -Wno-int-conversion \
		-Wno-implicit-function-declaration \
        -Wall -Wextra -fPIC \
		-fno-builtin-memcpy \
		-fno-builtin-memmove \
		-fno-builtin-memset \
        -Wno-unused-parameter \
	        -std=c99

CXXFLAGS = $(HOST_ARCH_FLAGS) $(HOST_POSIX_FLAGS) \
        -Wall -Wextra -fPIC \
		-fno-builtin-memcpy \
		-fno-builtin-memmove \
		-fno-builtin-memset \
        -Wno-unused-parameter \
        -pedantic \
		-fno-rtti \
	        -fno-exceptions \
        -fno-use-cxa-atexit \
        -std=c++14

ifeq ($(DEBUG),yes)
CFLAGS +=  -g
CXXFLAGS +=  -g
else
CFLAGS +=  -Oz -ffunction-sections -fdata-sections
CXXFLAGS +=  -Oz -ffunction-sections -fdata-sections
endif

# Optional link-time optimization. Enable with `make LTO=yes`; keeping it
# opt-in avoids changing the default build time and toolchain requirements.
ifeq ($(LTO),yes)
CFLAGS += -flto
CXXFLAGS += -flto
LDFLAGS += -flto
endif

# LITEHTML_LIFETIME_DEBUG is NOT a verbose-logging switch (that is XBROWSER_DEBUG):
# it compiles in the html_tag lifetime registry and the authoritative liveness
# gates in apply_stylesheet/apply_stylesheet_own/style_detached_subtree_walk.
# Without it those gates fall back to the element magic, which a freed node whose
# block the mario VM recycled reads back as "live" - so the style walk matches a
# dangling html_tag and aborts in selector_key_lower's std::string copy (w3.org
# freezes the whole window). Keep it on in EVERY build, including production.
CFLAGS   += -DLITEHTML_LIFETIME_DEBUG
CXXFLAGS += -DLITEHTML_LIFETIME_DEBUG

STL_HEADERS_STAMP = $(BUILD_DIR)/include/.stl_headers_timestamp

$(ARCH)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(ARCH)/%.o: %.cc
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(ARCH)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(ARCH)/%.o: %.S
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(ARCH)/%.o: %.s
	@mkdir -p $(dir $@)
	$(AS) $(ARCH_CFLAGS) -o $@ $<
